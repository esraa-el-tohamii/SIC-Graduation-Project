# Comma-separated browser origins. Use the separate static server origin only
# when running the frontend with `python serve.py`.
ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
# Optional absolute API URL exposed to the static frontend. Leave empty when
# the frontend is served by this FastAPI app.
GRIDGUARD_API_BASE_URL=
# Optional absolute directory containing the exported model files.
# MODEL_ARTIFACTS_DIR=
